{
    // Typecheck config: the same strictness as the build, applied to tests too.
    // The build config deliberately scopes itself to ./src (rootDir/outDir), so
    // tests get their own entry point here rather than widening that one.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        // The build config pins typeRoots to node_modules/@types; these two live elsewhere
        "typeRoots": ["./node_modules/@types", "./node_modules"],
        "types": ["vitest/globals", "@cloudflare/workers-types"]
    },
    "include": ["./src/**/*.ts", "./tests/**/*.ts", "./*.config.ts"],
    "exclude": ["node_modules", "./tests/fixtures/dist/**"]
}
